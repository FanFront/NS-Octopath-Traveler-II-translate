#version 450
layout(local_size_x=1,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=1,std430) buffer Result { vec4 pixels[]; } result;
layout(set=0,binding=2) uniform sampler3D source;
void main(){ivec3 p=ivec3(gl_GlobalInvocationID),s=textureSize(source,0);result.pixels[(p.z*s.y+p.y)*s.x+p.x]=texelFetch(source,p,0);}
