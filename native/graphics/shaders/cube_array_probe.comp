#version 450
layout(local_size_x=1) in;
layout(set=0,binding=1) uniform samplerCubeArray source;
layout(set=0,binding=2,std430) buffer Output {vec4 colors[];} result;
void main(){
    vec3 directions[6]=vec3[6](vec3(1,0,0),vec3(-1,0,0),vec3(0,1,0),vec3(0,-1,0),vec3(0,0,1),vec3(0,0,-1));
    for(int level=0;level<2;level++)for(int face=0;face<6;face++)result.colors[level*6+face]=textureLod(source,vec4(directions[face],0),float(level));
}
