#version 450
// Host-owned regression fixture: two draws must observe different descriptors
// even when they share a layout and retire at the same fence.
layout(local_size_x=1) in;
layout(set=0,binding=1) uniform InputValue { uvec4 value; } input_value;
layout(set=0,binding=2) buffer OutputValue { uvec4 value; } output_value;
void main() {
    output_value.value=input_value.value+uvec4(3,5,7,11);
}
