# 按本机实际路径修改后 source
export WS=/path/to/your/workdir
export S2A_INPUT="$WS/input"
export S2A_KEYS="$WS/keys/prod.keys"
export S2A_WORK="$WS/work"
export S2A_OUT="$WS/out"
export JAVA_HOME="$WS/toolchain/jdk/Contents/Home"
export ANDROID_HOME="$WS/sdk"
export ANDROID_USER_HOME="$WS/android-user-home"
export RUSTUP_HOME="$WS/toolchain/rustup"
export CARGO_HOME="$WS/toolchain/cargo"
export DOTNET_ROOT="$WS/toolchain/dotnet"
export DOTNET_CLI_HOME="$WS/toolchain/dotnet-cli"
export NUGET_PACKAGES="$WS/toolchain/nuget"
export GRADLE_USER_HOME="$WS/work/gradle-home"
export PATH="$WS/toolchain/bin:$WS/toolchain/cargo/bin:$WS/toolchain/dotnet:$WS/toolchain/spirv/bin:$WS/sdk/cmake/3.22.1/bin:$WS/sdk/platform-tools:$WS/sdk/cmdline-tools/latest/bin:$PATH"
